# Copy this file to `.env` and fill in real values.
# `.env` is gitignored - never commit real credentials.

# Base URL of the environment under test. Must end with a trailing slash.
BASE_URL=https://feature-us.aquaticinformatics.net/ops/

# Test account credentials
TEST_USER=
TEST_PASSWORD=

# Name of a plant that the test account can read. Used by smoke tests to
# navigate by name instead of hardcoding environment-specific GUIDs.
TEST_PLANT_NAME=

# Optional: name of a worksheet within the above plant.
TEST_WORKSHEET_NAME=

# --- Sample Manager (AQI-11578 custom observation tests) ---
# REQUIRED to run tests/full/sample-manager-custom-observation.spec.ts - there
# is no default. That suite writes real result data and unsubmits a real
# sample, so point it at an operation/sample you have set up specifically to
# be mutated by automated tests, never at shared or production configuration.
#
# The operation needs a text analyte linked to a Rio parameter that defines
# custom observations - that is specific configuration rather than something
# every plant has, so it is addressed by GUID. The suite snapshots and
# restores whatever value it finds, but only run it against a disposable
# sample you are comfortable with being unsubmitted and re-submitted.
SAMPLE_MANAGER_PLANT_ID=
SAMPLE_MANAGER_TEXT_ANALYTE=
SAMPLE_MANAGER_SAMPLE_NAME=
SAMPLE_MANAGER_CUSTOM_OBSERVATION=
